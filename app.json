{
  "expo": {
    "name": "Hermes Pocket",
    "slug": "hermes-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermes.pocket",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the pairing QR shown by your Hermes server.",
        "NSMicrophoneUsageDescription": "Record voice messages for your agent.",
        "NSFaceIDUsageDescription": "Unlock your saved server token."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.hermes.pocket",
      "permissions": ["CAMERA", "RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0E181B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E181B",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0E181B"
          },
          "android": {
            "image": "./assets/splash-icon-android.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR shown by your Hermes server.",
          "microphonePermission": "Record voice messages for your agent.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0E1B14",
          "defaultChannel": "hermes-alerts"
        }
      ],
      "expo-audio"
    ],
    "scheme": "hermes"
  }
}
